# ImageTrace OSINT — example environment. Contains NO credentials.
# Copy to .env (never commit .env). All settings are optional; sensible defaults exist.

# Server
IMAGETRACE_DATA_DIR=./data
IMAGETRACE_DATABASE_URL=sqlite:///./data/imagetrace.db
IMAGETRACE_FRONTEND_DIST=./frontend/dist
IMAGETRACE_CORS_ORIGINS=
# For split deployment (frontend on another host): comma-separated allowed origins.
# IMAGETRACE_CORS_ORIGINS=https://my-frontend.vercel.app

# HMAC key for signed URLs and owner-token hashing. Leave EMPTY to auto-generate
# a local 0600 key in IMAGETRACE_DATA_DIR/.secret_key (recommended for local use).
# In production set a long random value; NEVER put it in a URL or in Git.
IMAGETRACE_SECRET_KEY=

# Upload / retention / limits
IMAGETRACE_MAX_UPLOAD_MB=15
IMAGETRACE_MAX_URL_DOWNLOAD_MB=10
IMAGETRACE_RETENTION_HOURS=24
IMAGETRACE_RATE_LIMIT_PER_MINUTE=30
IMAGETRACE_SIGNED_URL_TTL=600

# External providers (all free, keyless, no credit card)
IMAGETRACE_EXTERNAL_PROVIDERS=true
IMAGETRACE_PROVIDER_TIMEOUT=6.0
IMAGETRACE_MAX_PROVIDER_RESULTS=12
# Recommended by Wikimedia's User-Agent policy; not a credential.
IMAGETRACE_CONTACT_EMAIL=

# Optional system binaries (no API keys needed)
# IMAGETRACE_TESSERACT_CMD=/usr/bin/tesseract
# ExifTool is detected automatically with `which exiftool`.

# Development only: process analyses synchronously (used by tests).
IMAGETRACE_SYNC_PROCESSING=false
# Never enable in production: allows fetching private-network URLs (SSRF).
IMAGETRACE_ALLOW_PRIVATE_NETWORKS=false

# Frontend build-time variable for split deployment (Vite reads VITE_*).
# Leave empty for same-origin deployment (recommended).
# VITE_API_BASE_URL=https://my-backend.onrender.com

# No paid API keys are used or required: Openverse, Wikimedia Commons,
# NASA Image Library and The Met Collection are public/keyless connectors;
# Google Lens / Bing / TinEye / Yandex, news, archives and forums are manual links only.
